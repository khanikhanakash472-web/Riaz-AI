// cyberHunt Function Example - Factorial

shuro
  // Function to calculate factorial
  func factorial(n)
    result = 1
    counter = 1
    jabbtak counter barabar n
      result = result gunaa counter
      counter = counter jodo 1
    khatam
    return result
  khatam
  
  likho "#2 Factorial Calculator"
  likho ""
  
  likho "5! = " factorial(5)
  likho "4! = " factorial(4)
  likho "3! = " factorial(3)
khatam
