// cyberHunt Function Example - Math Operations

shuro
  // Function to add two numbers
  func add(a, b)
    return a jodo b
  khatam
  
  // Function to multiply two numbers
  func multiply(x, y)
    return x gunaa y
  khatam
  
  // Function to calculate square
  func square(n)
    return n gunaa n
  khatam
  
  // Use the functions
  likho "#3 Math Operations"
  likho ""
  
  sum = add(5, 3)
  likho "5 jodo 3 = " sum
  
  product = multiply(4, 6)
  likho "4 gunaa 6 = " product
  
  sq = square(7)
  likho "7 gunaa 7 = " sq
khatam
