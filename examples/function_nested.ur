// cyberHunt Function Example - Nested Function Calls

shuro
  // Helper function
  func add(a, b)
    return a jodo b
  khatam
  
  // Function that calls another function
  func double_sum(x, y)
    sum = add(x, y)
    return sum gunaa 2
  khatam
  
  likho "#2 Nested Function Calls"
  likho ""
  
  result = double_sum(5, 3)
  likho "double_sum(5, 3) = " result
  
  result2 = double_sum(10, 20)
  likho "double_sum(10, 20) = " result2
khatam
